{
  "name": "airdrop-museum",
  "main": "src/worker.mjs",
  "account_id": "9880cf2cc57c2096f8c3ae253d9852e6",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "build": {
    "command": "node scripts/build-worker.mjs"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "airdrop-museum",
      "database_id": "4e75c8b9-6c58-4bac-a180-01e5bec0d0a3",
      "migrations_dir": "migrations"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "vars": {
    "RPC_1": "https://ethereum-rpc.publicnode.com",
    "RPC_8453": "https://base-rpc.publicnode.com",
    "PUBLIC_APP_URL": "https://airdrop-museum.xirraen.workers.dev",
    "AGGREGATOR_ALLOWED_HOSTS": "airdrop-museum.xirraen.workers.dev,docs.layer3.xyz,docs.layer3foundation.org,help.galxe.com,jup.ag",
    "AGGREGATOR_DISCOVERY_URLS": "https://airdrop-museum.xirraen.workers.dev/official-registry.json",
    "AGGREGATOR_MONITOR_SOURCES": "1"
  },
  "queues": {
    "producers": [
      {
        "binding": "AGGREGATOR_QUEUE",
        "queue": "airdrop-museum-aggregator"
      }
    ],
    "consumers": [
      {
        "queue": "airdrop-museum-aggregator",
        "max_batch_size": 5,
        "max_batch_timeout": 10,
        "max_retries": 3,
        "dead_letter_queue": "airdrop-museum-aggregator-dlq"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "AGGREGATOR_BACKUP_BUCKET",
      "bucket_name": "airdrop-museum-backups"
    }
  ]
}
