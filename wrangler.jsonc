{
  "name": "airdrop-museum",
  "main": "src/worker.mjs",
  "account_id": "9880cf2cc57c2096f8c3ae253d9852e6",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "build": {
    "command": "node scripts/build-worker.mjs"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "airdrop-museum",
      "database_id": "4e75c8b9-6c58-4bac-a180-01e5bec0d0a3",
      "migrations_dir": "migrations"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": [
      "17 * * * *",
      "*/30 * * * *",
      "37 */6 * * *",
      "*/5 * * * *"
    ]
  },
  "vars": {
    "RPC_1": "https://ethereum-rpc.publicnode.com",
    "RPC_8453": "https://base-rpc.publicnode.com",
    "TRUST_PUBLIC_ORIGIN": "https://airdrop-museum.xirraen.workers.dev",
    "PUBLIC_API_ORIGIN": "https://airdrop-museum.xirraen.workers.dev",
    "PUBLIC_API_ALLOWED_ORIGINS": "https://airdrop-museum.xirraen.workers.dev",
    "REQUIRE_RATE_LIMIT_BINDINGS": "1"
  },
  "queues": {
    "producers": [
      {
        "queue": "airdrop-museum-discovery",
        "binding": "DISCOVERY_QUEUE"
      },
      {
        "queue": "airdrop-museum-partner-webhook",
        "binding": "PARTNER_WEBHOOK_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "airdrop-museum-discovery",
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "airdrop-museum-discovery-dlq"
      },
      {
        "queue": "airdrop-museum-partner-webhook",
        "max_batch_size": 10,
        "max_retries": 4,
        "dead_letter_queue": "airdrop-museum-partner-webhook-dlq"
      },
      {
        "queue": "airdrop-museum-partner-webhook-dlq",
        "max_batch_size": 10,
        "max_retries": 0
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "TRUST_CACHE",
      "id": "bc8fc9f66cf7495f9ad2f2c4917e1674"
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "airdropmuseum_operations"
    }
  ],
  "ratelimits": [
    {
      "name": "PUBLIC_API_RATE_LIMITER",
      "namespace_id": "1008",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
